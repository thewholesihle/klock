<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
    <!-- Windows high-contrast: map everything onto the user's own system colours. -->
    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="CardBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="CardBorder" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="AccentFg" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="SegBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="SegSelected" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="SegSelectedFg" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="FieldBg" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="FieldBorder" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Hover" Color="{x:Static SystemColors.ControlLightColor}"/>
    <SolidColorBrush x:Key="Ring" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="PreviewBg" Color="#000000"/>
</ResourceDictionary>
